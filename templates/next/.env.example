# Copy to .env.local. Everything here is optional in development.

# Neon connection string. Leave unset to use local PGlite in .donta/pglite.
# DATABASE_URL="postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Required in production. Generate one with: openssl rand -base64 32
# BETTER_AUTH_SECRET=""

# The public URL of the app. Required in production; inferred from requests in development.
# BETTER_AUTH_URL="http://localhost:3000"
