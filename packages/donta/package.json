{
  "name": "donta",
  "version": "0.1.0",
  "description": "Runtime glue for donta projects: Neon, Drizzle and Better Auth.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./db": { "types": "./dist/db.d.mts", "default": "./dist/db.mjs" },
    "./env": { "types": "./dist/env.d.mts", "default": "./dist/env.mjs" },
    "./load-env": { "types": "./dist/load-env.d.mts", "default": "./dist/load-env.mjs" },
    "./drizzle-config": { "types": "./dist/drizzle-config.d.mts", "default": "./dist/drizzle-config.mjs" }
  },
  "files": ["dist"],
  "engines": { "node": ">=20.12" },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.5",
    "@neondatabase/serverless": ">=1",
    "drizzle-kit": ">=0.31",
    "drizzle-orm": ">=0.45"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": { "optional": true },
    "drizzle-kit": { "optional": true }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@neondatabase/serverless": "^1.2.0",
    "@types/node": "^22",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
