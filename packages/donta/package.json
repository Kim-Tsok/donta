{
  "name": "donta",
  "version": "0.1.0",
  "description": "Postgres with teeth. Runtime glue for Neon, Drizzle and Better Auth.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./db": { "types": "./dist/db.d.mts", "default": "./dist/db.mjs" },
    "./env": { "types": "./dist/env.d.mts", "default": "./dist/env.mjs" },
    "./drizzle-config": { "types": "./dist/drizzle-config.d.mts", "default": "./dist/drizzle-config.mjs" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.5",
    "@neondatabase/serverless": ">=1",
    "drizzle-kit": ">=0.31",
    "drizzle-orm": ">=0.45"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": { "optional": true },
    "@neondatabase/serverless": { "optional": true },
    "drizzle-kit": { "optional": true }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@neondatabase/serverless": "^1.2.0",
    "@types/node": "^22",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
